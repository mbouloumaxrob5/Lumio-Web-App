# .env.example — Lumio

# Database / Auth
DATABASE_URL="postgresql://user:pass@host:5432/lumio?schema=public"
NEXTAUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Embeddings
EMBEDDINGS_URL="http://localhost:8080"
EMBEDDING_DIM=1536
OPENAI_API_KEY="" # optional (used by embeddings proxy)

# Upload / provider
UPLOADTHING_ENDPOINT=""
UPLOADTHING_API_KEY=""
UPLOAD_MAX_BYTES=15728640
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp,image/avif"
UPLOAD_RATE_MAX=10
UPLOAD_RATE_WINDOW_MS=3600000
NEXT_PUBLIC_UPLOAD_MAX_SIZE=15728640

# Redis (required for distributed rate-limiter + SSE)
REDIS_URL="redis://localhost:6379"

# S3 (if using presigned PUT)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_PUBLIC_URL="https://your-bucket.s3.us-east-1.amazonaws.com"

# Observability (optional)
SENTRY_DSN=""
DATADOG_API_KEY=""
